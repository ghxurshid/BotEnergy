{
  "_note": "BotEnergy RabbitMQ topologiyasi. Faqat servislararo asinxron ish uchun — qurilma xabarlari MQTT'da qoladi. Bu topologiya `--profile messaging` bilan ishga tushadi; birinchi consumer yozilmaguncha kerak emas. Parollar bu faylda YO'Q: foydalanuvchilar `rabbitmqctl add_user` bilan deploy skriptida yaratiladi.",

  "vhosts": [
    { "name": "/botenergy" }
  ],

  "exchanges": [
    {
      "name": "botenergy.events",
      "vhost": "/botenergy",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "botenergy.commands",
      "vhost": "/botenergy",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "botenergy.retry",
      "vhost": "/botenergy",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "botenergy.dlx",
      "vhost": "/botenergy",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "notification.session",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "botenergy.dlx",
        "x-delivery-limit": 5
      }
    },
    {
      "name": "billing.process-finished",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "botenergy.dlx",
        "x-delivery-limit": 5
      }
    },
    {
      "name": "reporting.rollup",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "botenergy.dlx",
        "x-delivery-limit": 5
      }
    },
    {
      "name": "webhook.merchant",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "botenergy.dlx",
        "x-delivery-limit": 8
      }
    },
    {
      "name": "botenergy.retry.30s",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "botenergy.events"
      }
    },
    {
      "name": "botenergy.dead",
      "vhost": "/botenergy",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],

  "bindings": [
    {
      "source": "botenergy.events",
      "vhost": "/botenergy",
      "destination": "notification.session",
      "destination_type": "queue",
      "routing_key": "session.*",
      "arguments": {}
    },
    {
      "source": "botenergy.events",
      "vhost": "/botenergy",
      "destination": "billing.process-finished",
      "destination_type": "queue",
      "routing_key": "process.finished",
      "arguments": {}
    },
    {
      "source": "botenergy.events",
      "vhost": "/botenergy",
      "destination": "reporting.rollup",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "botenergy.events",
      "vhost": "/botenergy",
      "destination": "webhook.merchant",
      "destination_type": "queue",
      "routing_key": "session.closed",
      "arguments": {}
    },
    {
      "source": "botenergy.events",
      "vhost": "/botenergy",
      "destination": "webhook.merchant",
      "destination_type": "queue",
      "routing_key": "payment.*",
      "arguments": {}
    },
    {
      "source": "botenergy.retry",
      "vhost": "/botenergy",
      "destination": "botenergy.retry.30s",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "botenergy.dlx",
      "vhost": "/botenergy",
      "destination": "botenergy.dead",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],

  "users": [],
  "permissions": [],
  "policies": [],
  "parameters": [],
  "global_parameters": [],
  "topic_permissions": [],
  "rabbit_version": "3.13.0"
}
