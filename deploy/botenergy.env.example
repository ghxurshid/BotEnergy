# ─────────────────────────────────────────────────────────────────────────────
# BotEnergy production env — NAMUNA.
#
# Serverga /etc/botenergy/botenergy.env sifatida ko'chiring va HAQIQIY qiymatlarni
# qo'ying. Bu fayl git'da; haqiqiy qiymatli nusxa HECH QACHON git'ga tushmasligi kerak.
#
# ODATDA QO'LDA EMAS — generator ishlatiladi (sirlarni o'zi yaratadi va
# takrorlanuvchi qiymatlarni mos qo'yadi):
#
#   sudo BOTENERGY_DOMAIN=<domen> bash deploy/scripts/generate-env.sh
#
# Qo'lda qilmoqchi bo'lsangiz:
#   sudo install -d -m 0700 -o root -g root /etc/botenergy
#   sudo install -m 0640 -o root -g docker deploy/botenergy.env.example /etc/botenergy/botenergy.env
#   sudo nano /etc/botenergy/botenergy.env
#
# Huquq root:docker 0640 — GitHub runner `docker run --env-file` orqali o'qiydi.
#
# Env var'lar Configuration.Production.json'dagi "Env_*" placeholder'larni override qiladi.
# Ikki pastki chiziq (__) JSON ierarxiyasidagi ":" ni bildiradi.
# ─────────────────────────────────────────────────────────────────────────────

# ── .NET ────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Ma'lumotlar bazasi ──────────────────────────────────────────────────────
# Parol: openssl rand -base64 24
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=botenergy_db;Username=botenergy_user;Password=CHANGE_ME

# postgres konteyneri init uchun (birinchi ishga tushishda baza yaratadi)
POSTGRES_DB=botenergy_db
POSTGRES_USER=botenergy_user
POSTGRES_PASSWORD=CHANGE_ME

# postgres_exporter uchun
DATA_SOURCE_NAME=postgresql://botenergy_user:CHANGE_ME@postgres:5432/botenergy_db?sslmode=disable

# ── JWT ─────────────────────────────────────────────────────────────────────
# Kamida 64 belgi: openssl rand -base64 64 | tr -d '\n'
# DIQQAT: bu qiymatni o'zgartirish barcha access tokenlarni bekor qiladi
# (foydalanuvchilar refresh token bilan avtomatik qayta login qiladi).
Jwt__Secret=CHANGE_ME
Jwt__Issuer=https://company.uz
Jwt__ValidateIssuer=true

# ── Default admin (faqat birinchi seed'da ishlatiladi) ──────────────────────
# Berilmasa default admin UMUMAN yaratilmaydi — bu xavfsizroq default.
Seed__AdminPassword=CHANGE_ME

# ── MQTT (EMQX) ─────────────────────────────────────────────────────────────
# Backend servisning broker paroli. Qurilma parollari BU YERDA EMAS — ular
# har bir qurilmaning SecretKey'idan hosil qilinadi (DeviceMqttCredentials).
Mqtt__Password=CHANGE_ME
Mqtt__BrokerHost=emqx
Mqtt__BrokerPort=8883
Mqtt__UseTls=true
Mqtt__SharedSubscriptionGroup=botenergy

# EMQX konteyneri uchun
EMQX_NODE_COOKIE=CHANGE_ME
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
INTERNAL_API_SHARED_SECRET=CHANGE_ME

# ── Internal servis-servis ──────────────────────────────────────────────────
# EMQX authn/authz hook'i shu qiymat bilan DeviceApi'ga murojaat qiladi —
# INTERNAL_API_SHARED_SECRET bilan BIR XIL bo'lishi shart.
InternalApi__SharedSecret=CHANGE_ME

# ── Redis ───────────────────────────────────────────────────────────────────
Redis__ConnectionString=redis:6379

# ── CORS / domen ────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=https://company.uz

# ── Payme ───────────────────────────────────────────────────────────────────
Payme__MerchantId=CHANGE_ME
Payme__Key=CHANGE_ME

# ── Observability ───────────────────────────────────────────────────────────
Observability__ConsoleJsonLogs=true
Observability__EnableTracing=true
Observability__EnableMetrics=true
Observability__OtlpEndpoint=http://tempo:4317

GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
ALERT_TELEGRAM_CHAT_ID=CHANGE_ME

# ── Migratsiya ──────────────────────────────────────────────────────────────
# false — servislar bootda migratsiya qilmaydi, buni Migrator konteyneri bajaradi.
Migrate__AutoApply=false

# ── Swagger ─────────────────────────────────────────────────────────────────
# Production'da API yuzasini oshkor qilmaslik uchun o'chiq.
Swagger__Enabled=false
