# ─────────────────────────────────────────────────────────────────────────────
# BotEnergy production sirlari — NAMUNA.
#
# Nega kerak: Configuration.Production.json'da endi haqiqiy sirlar yo'q, faqat
# "Env_*" placeholder'lar. Servis env var'ni topmasa fail-fast qiladi (JWT
# secret'siz ishga tushib ketishdan ko'ra to'xtagani yaxshi). Repo public —
# sirlar git'ga qaytmasligi kerak.
#
# 1) Serverga qo'ying:
#      sudo install -d -m 0750 /etc/botenergy
#      sudo install -m 0640 -o root -g ubuntu deploy/botenergy.env.example \
#           /etc/botenergy/botenergy.env
#      sudo nano /etc/botenergy/botenergy.env
#
#    0640 root:ubuntu — deploy.sh migratsiya uchun o'qiydi (guruh: deploy useri).
#
# 2) Mavjud unit'larga bir qatordan qo'shing (unit fayllarga tegmasdan, drop-in):
#      for s in AuthApi UserApi AdminApi BillingApi PaymentApi DeviceApi SessionApi; do
#        sudo mkdir -p /etc/systemd/system/botenergy-$s.service.d
#        printf '[Service]\nEnvironmentFile=/etc/botenergy/botenergy.env\n' \
#          | sudo tee /etc/systemd/system/botenergy-$s.service.d/env.conf >/dev/null
#      done
#      sudo systemctl daemon-reload
#
# Format: systemd EnvironmentFile — KEY=VALUE, qo'shtirnoqsiz, '#' izoh.
# Ikki pastki chiziq (__) JSON ierarxiyasidagi ":" ni bildiradi.
# Sir yaratish: openssl rand -base64 96 | tr -dc 'A-Za-z0-9' | head -c 64; echo
# ─────────────────────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production

# ── Ma'lumotlar bazasi ──────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=botenergy_db;Username=botenergy_user;Password=CHANGE_ME

# ── JWT ─────────────────────────────────────────────────────────────────────
# O'zgarsa barcha access token bekor bo'ladi (refresh orqali avtomatik tiklanadi).
Jwt__Secret=CHANGE_ME
Jwt__Issuer=https://company.uz

# ── Default admin (faqat birinchi seed'da; berilmasa admin YARATILMAYDI) ────
Seed__AdminPassword=CHANGE_ME

# ── MQTT ────────────────────────────────────────────────────────────────────
Mqtt__Password=CHANGE_ME

# ── Internal servis-servis (MQTT broker authn/authz hook -> DeviceApi) ──────
InternalApi__SharedSecret=CHANGE_ME

# ── CORS ────────────────────────────────────────────────────────────────────
# "*" — har qanday origin ochiq. Env var json'dagi Cors:AllowedOrigins ni OVERRIDE qiladi,
# shuning uchun bu yerda aniq domen tursa, konfiguratsiya fayliga nima yozilganidan qat'i
# nazar boshqa hamma origin bloklanadi (brauzerda "Failed to fetch", serverda xato yo'q).
# Domen aniq bo'lgach: Cors__AllowedOrigins__0=https://sizning-domen.uz (oxirida "/" QO'YMANG).
Cors__AllowedOrigins__0=*

# ── Payme ───────────────────────────────────────────────────────────────────
Payme__MerchantId=CHANGE_ME
Payme__Key=CHANGE_ME
