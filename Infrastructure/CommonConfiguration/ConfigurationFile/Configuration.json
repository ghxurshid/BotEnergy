{
  "Hosting": {
    "UseHttps": false,
    "Ports": {
      "Gateway": 5008,
      "AdminApi": 5001,
      "AuthApi": 5002,
      "BillingApi": 5003,
      "DeviceApi": 5004,
      "PaymentApi": 5005,
      "UserApi": 5006,
      "SessionApi": 5007
    }
  },

  "Jwt": {
    "Issuer": "https://company.uz",
    "ValidateIssuer": false,
    "ClockSkewSeconds": 30
  },

  // Bu fayl HAR DOIM yuklanadi (optional:false), muhit fayli esa yuklanmasligi mumkin.
  // AllowAnyOrigin ro'yxatdan ustun turadi — serverdagi Cors__AllowedOrigins__0 env var'i
  // (u json'ni override qiladi) noto'g'ri domen tutib qolsa ham brauzer bloklanmaydi.
  // Domen aniq bo'lgach false qiling va Cors:AllowedOrigins ro'yxatiga o'ting.
  "Cors": {
    "AllowAnyOrigin": true
  },

  "Swagger": {
    "Enabled": true
  },

  "Migrate": {
    "AutoApply": true
  },

  "RateLimit": {
    "PermitPerMinute": 30,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "PerUserBurst": 120,
    "PerUserPerMinute": 60
  },

  "Observability": {
    "ConsoleJsonLogs": false,
    "OtlpEndpoint": "",
    "EnableTracing": false,
    "EnableMetrics": true
  },

  "Mqtt": {
    "SharedSubscriptionGroup": "botenergy"
  },

  "ReverseProxy": {
    // Har bir route'dagi { "X-Forwarded": "Set", "Prefix": "Off" } MAJBURIY.
    // YARP standart holatda o'zining X-Forwarded-Prefix transformini qo'shadi va uni
    // gateway'ning PathBase'iga tenglashtiradi. PathBase bo'sh (gateway ildizda turadi),
    // "Set" esa bo'sh qiymatda header'ni O'CHIRIB yuboradi — ya'ni bizning
    // { "RequestHeader": "X-Forwarded-Prefix", "Set": "/auth" } qatorimiz bekor bo'lardi.
    // Oqibati: downstream Swagger `servers` ni to'ldirmaydi va "Try it out"
    // {gw}/api/... ga (prefikssiz) urib 404 oladi. "Prefix": "Off" YARP'ning o'sha
    // transformini butunlay o'chiradi; For/Proto/Host esa "Set" bo'lib qolaveradi —
    // ular downstream'dagi UseProxyForwardedHeaders va rate limiting uchun kerak.
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**catch-all}" },
        "RateLimiterPolicy": "auth-strict",
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/auth" }
        ]
      },
      "user": {
        "ClusterId": "user",
        "Match": { "Path": "/user/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Transforms": [
          { "PathRemovePrefix": "/user" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/user" }
        ]
      },
      "admin": {
        "ClusterId": "admin",
        "Match": { "Path": "/admin/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Transforms": [
          { "PathRemovePrefix": "/admin" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/admin" }
        ]
      },
      "session": {
        "ClusterId": "session",
        "Match": { "Path": "/session/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Transforms": [
          { "PathRemovePrefix": "/session" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/session" }
        ]
      },
      "billing": {
        "ClusterId": "billing",
        "Match": { "Path": "/billing/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Transforms": [
          { "PathRemovePrefix": "/billing" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/billing" }
        ]
      },
      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/payment/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/payment" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/payment" }
        ]
      },
      "device": {
        "ClusterId": "device",
        "Match": { "Path": "/device/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Transforms": [
          { "PathRemovePrefix": "/device" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/device" }
        ]
      },
      "hubs": {
        "ClusterId": "session",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },

      // Swagger route'lari: Order=-1 bilan asosiy route'lardan OLDIN tekshiriladi va
      // AuthorizationPolicy'siz — Swagger UI hujjatni tokensiz o'qiy olishi uchun.
      // Downstream'da Swagger:Enabled false bo'lsa baribir 404 qaytadi.
      "auth-swagger": {
        "ClusterId": "auth",
        "Order": -1,
        "Match": { "Path": "/auth/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/auth" }
        ]
      },
      "user-swagger": {
        "ClusterId": "user",
        "Order": -1,
        "Match": { "Path": "/user/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/user" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/user" }
        ]
      },
      "admin-swagger": {
        "ClusterId": "admin",
        "Order": -1,
        "Match": { "Path": "/admin/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/admin" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/admin" }
        ]
      },
      "session-swagger": {
        "ClusterId": "session",
        "Order": -1,
        "Match": { "Path": "/session/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/session" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/session" }
        ]
      },
      "billing-swagger": {
        "ClusterId": "billing",
        "Order": -1,
        "Match": { "Path": "/billing/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/billing" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/billing" }
        ]
      },
      "payment-swagger": {
        "ClusterId": "payment",
        "Order": -1,
        "Match": { "Path": "/payment/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/payment" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/payment" }
        ]
      },
      "device-swagger": {
        "ClusterId": "device",
        "Order": -1,
        "Match": { "Path": "/device/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/device" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/device" }
        ]
      }
    },

    "Clusters": {
      "auth": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "auth-1": { "Address": "http://localhost:5002/" } }
      },
      "user": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "user-1": { "Address": "http://localhost:5006/" } }
      },
      "admin": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "admin-1": { "Address": "http://localhost:5001/" } }
      },
      "billing": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "billing-1": { "Address": "http://localhost:5003/" } }
      },
      "payment": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "payment-1": { "Address": "http://localhost:5005/" } }
      },
      "device": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "device-1": { "Address": "http://localhost:5004/" } }
      },
      "session": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".BotEnergy.Affinity",
          "FailurePolicy": "Redistribute",
          "Cookie": { "SameSite": "None", "SecurePolicy": "Always", "HttpOnly": true }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:00",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "session-1": { "Address": "http://localhost:5007/" } }
      }
    }
  }
}
