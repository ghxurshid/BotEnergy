{
  "_note": "Production sirlar SHU FAYLDA SAQLANMAYDI. Barcha 'Env_*' qiymatlar placeholder — ResolveSecret ularni 'berilmagan' deb biladi va servis fail-fast qiladi. Haqiqiy qiymatlarni systemd EnvironmentFile beradi (/etc/botenergy/botenergy.env): ConnectionStrings__DefaultConnection, Jwt__Secret, Mqtt__Password, InternalApi__SharedSecret, Seed__AdminPassword, Payme__MerchantId, Payme__Key. Env var json'dagi qiymatni override qiladi.",

  "ConnectionStrings": {
    "DefaultConnection": "Env_ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Secret": "Env_Jwt__Secret",
    "Issuer": "https://company.uz",
    "ValidateIssuer": true
  },
  "Seed": {
    "AdminPassword": "Env_Seed__AdminPassword"
  },
  "Otp": {
    "AllowTestCode": false,
    "TtlMinutes": 3,
    "MaxAttempts": 5
  },
  "RateLimit": {
    "PermitPerMinute": 30,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "PerUserBurst": 120,
    "PerUserPerMinute": 60
  },
  // "*" — har qanday origin ochiq (simulyatorlar nginx ostidan va localhost'dan ishlaydi).
  // Domen aniq bo'lgach shu yerga ro'yxat qilib yozing, "*" ni olib tashlang.
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  // Gateway'dagi umumiy Swagger UI ({gateway}/swagger) shu bayroqqa bog'liq — hozir
  // sinov bosqichi uchun yoqilgan. Ishga tushirilgach false qiling: API yuzasi,
  // model'lar va endpoint ro'yxati aks holda ochiq turadi.
  "Swagger": {
    "Enabled": true
  },
  "Migrate": {
    "AutoApply": false
  },
  "Mqtt": {
    "BrokerHost": "localhost",
    "BrokerPort": 8883,
    "Username": "botenergy-backend",
    "Password": "Env_Mqtt__Password",
    "ClientId": "botenergy-session-api",
    "UseTls": true,
    "AllowUntrustedCertificates": false,
    "ClientCertificatePath": null,
    "ClientCertificatePassword": null,
    "SharedSubscriptionGroup": "botenergy"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "InternalApi": {
    "SharedSecret": "Env_InternalApi__SharedSecret",
    // AdminApi → SessionApi (inkassatsiya "boxni ochish" buyrug'i). Localhost:
    // servis portlari tashqaridan yopiq, chaqiruv server ichida qoladi.
    "SessionApiBaseUrl": "http://localhost:5007"
  },
  "Payme": {
    "BaseUrl": "https://checkout.paycom.uz/api",
    "MerchantId": "Env_Payme__MerchantId",
    "Key": "Env_Payme__Key",
    "TimeoutSeconds": 30
  },
  // Haqiqiy bank integratsiyasi kelguncha Fake. Provider almashganda BaseUrl va
  // sirlar env var orqali beriladi (Bank__ApiKey kabi) — bu faylga yozilmaydi.
  "Bank": {
    "Provider": "Fake",
    "BaseUrl": "",
    "TimeoutSeconds": 30,
    "Fake": {
      "DelayMs": 0,
      "FailureRate": 0,
      "RejectCardPrefix": "0000"
    }
  },
  "CashTopUp": {
    "WatcherIntervalSeconds": 10,
    "LeaseSeconds": 60,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BackoffBaseSeconds": 10,
    "BackoffMaxSeconds": 900,
    "IdleTimeoutMinutes": 5,
    "IdleCheckIntervalSeconds": 60,
    "AllowedDenominations": [ 1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000 ],
    "MaxSessionAmount": 50000000
  },
  "HoldInvoices": {
    "WatcherIntervalSeconds": 5,
    "PollSeconds": 3,
    "LeaseSeconds": 30,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BackoffBaseSeconds": 5,
    "BackoffMaxSeconds": 300,
    "InvoiceTtlMinutes": 30,
    "MaxInvoicesPerSession": 10,
    "SendReceiptToPhone": false
  },
  "Observability": {
    "ConsoleJsonLogs": true,
    "OtlpEndpoint": "",
    "EnableTracing": false,
    "EnableMetrics": true
  }
}
