{
  "_note": "Production sirlar SHU FAYLDA SAQLANMAYDI. Barcha 'Env_*' qiymatlar placeholder — ResolveSecret ularni 'berilmagan' deb biladi va servis fail-fast qiladi. Haqiqiy qiymatlarni server env var sifatida beradi (/etc/botenergy/botenergy.env): ConnectionStrings__DefaultConnection, Jwt__Secret, Mqtt__Password, InternalApi__SharedSecret, Seed__AdminPassword, Payme__MerchantId, Payme__Key. Env var json'dagi qiymatni override qiladi.",

  "ConnectionStrings": {
    "DefaultConnection": "Env_ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Secret": "Env_Jwt__Secret",
    "Issuer": "https://company.uz",
    "ValidateIssuer": true
  },
  "Seed": {
    "AdminPassword": "Env_Seed__AdminPassword"
  },
  "Otp": {
    "AllowTestCode": false,
    "TtlMinutes": 3,
    "MaxAttempts": 5
  },
  "RateLimit": {
    "PermitPerMinute": 30,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "PerUserBurst": 120,
    "PerUserPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://company.uz"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Migrate": {
    "AutoApply": false
  },
  "Mqtt": {
    "BrokerHost": "emqx",
    "BrokerPort": 8883,
    "Username": "botenergy-backend",
    "Password": "Env_Mqtt__Password",
    "ClientId": "botenergy-session-api",
    "UseTls": true,
    "AllowUntrustedCertificates": false,
    "ClientCertificatePath": null,
    "ClientCertificatePassword": null,
    "SharedSubscriptionGroup": "botenergy"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "InternalApi": {
    "SharedSecret": "Env_InternalApi__SharedSecret"
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "/etc/botenergy/certs/botenergy.pfx",
        "Password": "Env_Kestrel__Certificates__Default__Password"
      }
    }
  },
  "Payme": {
    "BaseUrl": "https://checkout.paycom.uz/api",
    "MerchantId": "Env_Payme__MerchantId",
    "Key": "Env_Payme__Key",
    "TimeoutSeconds": 30
  },
  "HoldInvoices": {
    "WatcherIntervalSeconds": 5,
    "PollSeconds": 3,
    "LeaseSeconds": 30,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BackoffBaseSeconds": 5,
    "BackoffMaxSeconds": 300,
    "InvoiceTtlMinutes": 30,
    "MaxInvoicesPerSession": 10,
    "SendReceiptToPhone": false
  },
  "Observability": {
    "ConsoleJsonLogs": true,
    "OtlpEndpoint": "http://tempo:4317",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "ReverseProxy": {
    "Clusters": {
      "auth": { "Destinations": { "auth-1": { "Address": "http://authapi:5002/" } } },
      "user": { "Destinations": { "user-1": { "Address": "http://userapi:5006/" } } },
      "admin": { "Destinations": { "admin-1": { "Address": "http://adminapi:5001/" } } },
      "session": { "Destinations": { "session-1": { "Address": "http://sessionapi:5007/" } } },
      "billing": { "Destinations": { "billing-1": { "Address": "http://billingapi:5003/" } } },
      "payment": { "Destinations": { "payment-1": { "Address": "http://paymentapi:5005/" } } },
      "device": { "Destinations": { "device-1": { "Address": "http://deviceapi:5004/" } } }
    }
  }
}
